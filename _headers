# Baseline browser hardening for the public site and staff workspace.
# Staff access still depends on Supabase Auth, MFA and RLS.
/*
  Referrer-Policy: strict-origin-when-cross-origin

/staff*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://esm.sh; style-src 'self'; img-src 'self' data:; connect-src 'self' https://deqokqorcukbubirosqg.supabase.co; font-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
